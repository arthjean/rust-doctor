//! rust-doctor truth fixture
//! rule: excessive-clone
//! crate-role: binary
//! source-surface: binary
//! target-path: src/main.rs
//! edition: 2024
//! msrv: 1.97

#[derive(Clone, Debug, Default)]
struct Job {
    name: String,
    args: Vec<String>,
}

fn main() {
    let template = Job::default();
    let jobs = plan(&template, 4);
    println!("{}", jobs.len());
}

fn plan(template: &Job, count: usize) -> Vec<Job> {
    let mut jobs = Vec::new();
    for index in 0..count {
        let mut job = template.clone(); //~ pos
        job.name = format!("{}-{index}", template.name); //~ neg
        job.args = template.args.clone(); //~ pos
        jobs.push(job);
    }
    jobs
}

fn plan_borrowed(template: &Job, count: usize) -> Vec<String> {
    (0..count) //~ neg
        .map(|index| format!("{}-{index}", template.name))
        .collect()
}

fn rename_all(jobs: &[Job], suffix: &str) -> Vec<Job> {
    let mut output = Vec::new();
    for job in jobs {
        let mut renamed = job.clone(); //~ pos
        renamed.name.push_str(suffix); //~ neg
        output.push(renamed);
    }
    output
}

fn describe(jobs: &[Job]) -> Vec<String> {
    let mut output = Vec::new();
    for job in jobs {
        output.push(job.name.clone()); //~ pos
    }
    output
}

fn describe_borrowed(jobs: &[Job]) -> Vec<&str> {
    jobs.iter().map(|job| job.name.as_str()).collect() //~ neg
}

fn retry(job: &Job, attempts: usize) -> Vec<Job> {
    let mut output = Vec::new();
    let mut current = job.clone(); //~ pos
    for _ in 0..attempts {
        current = current.clone(); //~ pos
        output.push(current.clone()); //~ pos
    }
    output
}

fn retry_count(job: &Job) -> usize {
    job.args.len() //~ neg
}

fn merge_args(left: &Job, right: &Job) -> Vec<String> {
    let mut args = left.args.clone(); //~ pos
    args.extend(right.args.clone()); //~ pos
    args
}

fn merge_args_borrowed<'a>(left: &'a Job, right: &'a Job) -> Vec<&'a String> {
    left.args.iter().chain(right.args.iter()).collect() //~ neg
}
