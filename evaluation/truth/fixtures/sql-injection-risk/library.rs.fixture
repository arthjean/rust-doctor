    pool.query(&format!("SELECT * FROM audit WHERE actor = '{actor}'")) //~ pos
}

pub fn audit_trail_bound(pool: &Pool, actor: &str) -> usize {
    pool.prepare("SELECT * FROM audit WHERE actor = $1").bind(actor).run() //~ neg
}

pub fn tenant_rows(pool: &Pool, tenant: &str) -> String {
    pool.fetch_one(&format!("SELECT * FROM tenants WHERE slug = '{tenant}'")) //~ pos
}

pub fn tenant_rows_query(pool: &Pool, tenant: &str) -> Vec<String> {
    pool.query(&format!("SELECT * FROM tenants WHERE slug = '{tenant}'")) //~ pos
}

pub fn report(pool: &Pool, from: &str, to: &str) -> usize {
    pool.execute(&format!("SELECT * FROM events WHERE ts BETWEEN '{from}' AND '{to}'")) //~ pos
}

pub fn report_bound(pool: &Pool) -> usize {
    pool.execute("SELECT * FROM events WHERE ts BETWEEN $1 AND $2") //~ neg
}

pub fn upsert(pool: &Pool, key: &str, value: &str) -> usize {
    pool.execute(&format!("INSERT INTO kv VALUES ('{key}', '{value}')")) //~ pos
}

pub fn upsert_bound(pool: &Pool, key: &str, value: &str) -> usize {
    let _ = (key, value);
    pool.execute("INSERT INTO kv VALUES ($1, $2)") //~ neg
}

pub fn migrate(pool: &Pool, version: u32) -> Vec<String> {
    pool.raw(&format!("UPDATE schema_version SET current = {version}")) //~ pos
}

pub fn migrate_static(pool: &Pool) -> Vec<String> {
    pool.raw("UPDATE schema_version SET current = current + 1") //~ neg
}

pub fn labelled(pool: &Pool, label: &str) -> Vec<String> {
    let statement = "SELECT * FROM labels WHERE name = $1"; //~ neg
    let _ = label;
    pool.query(statement) //~ neg
}

pub fn prepared_once(pool: &Pool, values: &[String]) -> usize {
    let statement = pool.prepare("INSERT INTO kv VALUES ($1)"); //~ neg
    values.iter().map(|value| statement.bind(value).run()).sum() //~ neg
}
