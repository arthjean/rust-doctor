# No trailing slash: a directory-only pattern does not cover a `target` that is
# a symbolic link to a build directory elsewhere, which is a common way to move
# build output off a small disk. Without this the link itself stays untracked
# and committable, and rust-doctor reports it against this repository.
/target
/tests/fixtures/projects/*/target/
/tests/fixtures/projects/*/Cargo.lock
/tests/fixtures/kernel-contract/*/target/
/tests/fixtures/kernel-contract/*/Cargo.lock
/tests/fixtures/cargo-health/*/target/
/tests/fixtures/cargo-health/resolution/*/target/
/tests/fixtures/source-kernel/*/target/
/tests/fixtures/configuration-kernel/workspace/Cargo.lock
/tests/fixtures/configuration-kernel/workspace/target/
/tests/fixtures/rule-admission/*/target/
/tests/fixtures/rule-scaling-kernel/*/target/
/tests/fixtures/score-credibility/*/target/
/tests/fixtures/score-credibility/packs/*/target/
/tests/fixtures/structure/*/target/
/npm/rust-doctor/node_modules/
/npm/rust-doctor/*.tgz
/.claude/.paneflow-hook-leases
/.claude/settings.local.json
/tests/fixtures/suppression/*/target/
/tests/fixtures/dependency-truth/*/target/
/tests/fixtures/profile-hardening/*/target/
