struct Pool;
struct Statement;

impl Pool {
    fn query(&self, _sql: &str) -> Vec<String> { Vec::new() }
    fn query_as(&self, _sql: &str) -> Vec<String> { Vec::new() }
    fn execute(&self, _sql: &str) -> usize { 0 }
    fn execute_raw(&self, _sql: &str) -> usize { 0 }
    fn raw(&self, _sql: &str) -> Vec<String> { Vec::new() }
    fn prepare(&self, _sql: &str) -> Statement { Statement }
}

impl Statement {
    fn bind(&self, _value: &str) -> &Self { self }
    fn run(&self) -> usize { 0 }
}

fn main() {
    let pool = Pool;
    println!("{}", list(&pool, "active").len());
}

fn list(pool: &Pool, status: &str) -> Vec<String> {
    pool.query(&format!("SELECT id FROM jobs WHERE status = '{status}'")) //~ pos
}

fn list_bound(pool: &Pool, status: &str) -> usize {
    pool.prepare("SELECT id FROM jobs WHERE status = $1").bind(status).run() //~ neg
}

fn cancel(pool: &Pool, id: u64) -> usize {
    pool.execute(&format!("UPDATE jobs SET state = 'cancelled' WHERE id = {id}")) //~ pos
}

fn cancel_bound(pool: &Pool) -> usize {
    pool.execute("UPDATE jobs SET state = 'cancelled' WHERE id = $1") //~ neg
}

fn drain(pool: &Pool, queue: &str) -> Vec<String> {
    pool.raw(&format!("DELETE FROM {queue} RETURNING id")) //~ pos
}

fn drain_static(pool: &Pool) -> Vec<String> {
    pool.raw("DELETE FROM queue RETURNING id") //~ neg
}

fn stats(pool: &Pool, window: u32) -> Vec<String> {
    pool.query_as(&format!("SELECT count(*) FROM jobs WHERE age < {window}")) //~ pos
}

fn stats_static(pool: &Pool) -> Vec<String> {
    pool.query_as("SELECT count(*) FROM jobs WHERE age < $1") //~ neg
}

fn reindex(pool: &Pool, table: &str) -> usize {
    pool.execute_raw(&format!("REINDEX TABLE {table}")) //~ pos
}

fn reindex_static(pool: &Pool) -> usize {
    pool.execute_raw("REINDEX TABLE jobs") //~ neg
}

fn purge_before(pool: &Pool, cutoff: &str) -> usize {
    pool.execute(&format!("DELETE FROM jobs WHERE created_at < '{cutoff}'")) //~ pos
}

fn purge_before_bound(pool: &Pool) -> usize {
    pool.execute("DELETE FROM jobs WHERE created_at < $1") //~ neg
}

fn find_by_owner(pool: &Pool, owner: &str) -> Vec<String> {
    pool.query(&format!("SELECT * FROM jobs WHERE owner = '{owner}'")) //~ pos
}

fn find_by_owner_bound(pool: &Pool, owner: &str) -> usize {
    pool.prepare("SELECT * FROM jobs WHERE owner = $1").bind(owner).run() //~ neg
}
