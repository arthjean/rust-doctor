//! rust-doctor truth fixture
//! rule: collect-then-iterate
//! crate-role: binary
//! source-surface: binary
//! target-path: src/main.rs
//! edition: 2024
//! msrv: 1.97

fn main() {
    let args: Vec<String> = std::env::args().collect(); //~ neg
    println!("{}", total_bytes(&args));
}

fn total_bytes(values: &[String]) -> usize {
    values.iter().map(String::len).collect::<Vec<_>>().iter().sum() //~ pos
}

fn total_bytes_direct(values: &[String]) -> usize {
    values.iter().map(String::len).sum() //~ neg
}

fn filtered(values: &[String]) -> Vec<String> {
    values.iter().filter(|value| !value.is_empty()).cloned().collect::<Vec<_>>().into_iter().collect() //~ pos
}

fn filtered_direct(values: &[String]) -> Vec<String> {
    values.iter().filter(|value| !value.is_empty()).cloned().collect() //~ neg
}

fn sorted_names(values: &[String]) -> Vec<String> {
    let mut names: Vec<String> = values.iter().cloned().collect(); //~ neg
    names.sort();
    names
}

fn shortest(values: &[String]) -> Option<usize> {
    values.iter().map(String::len).collect::<Vec<_>>().iter().copied().min() //~ pos
}

fn shortest_direct(values: &[String]) -> Option<usize> {
    values.iter().map(String::len).min() //~ neg
}

fn dedup_count(values: &[String]) -> usize {
    values.iter().collect::<std::collections::HashSet<_>>().iter().count() //~ pos
}

fn dedup_count_direct(values: &[String]) -> usize {
    values.iter().collect::<std::collections::HashSet<_>>().len() //~ neg
}

fn windows(values: &[String]) -> usize {
    values.iter().collect::<Vec<_>>().iter().rev().count() //~ pos
}

fn windows_direct(values: &[String]) -> usize {
    values.iter().rev().count() //~ neg
}

fn indexed(values: &[String]) -> usize {
    values.iter().enumerate().collect::<Vec<_>>().iter().count() //~ pos
}

fn indexed_direct(values: &[String]) -> usize {
    values.iter().enumerate().count() //~ neg
}

fn chunked(values: &[String]) -> usize {
    values.chunks(2).collect::<Vec<_>>().iter().count() //~ pos
}

fn chunked_direct(values: &[String]) -> usize {
    values.chunks(2).count() //~ neg
}
