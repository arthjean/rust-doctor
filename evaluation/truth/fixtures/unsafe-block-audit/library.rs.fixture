use std::ffi::c_void;

pub fn read_first(values: &[u8]) -> u8 {
    unsafe { *values.get_unchecked(0) } //~ pos
}

pub fn read_first_checked(values: &[u8]) -> Option<u8> {
    values.first().copied() //~ neg
}

pub fn read_last(values: &[u8]) -> u8 {
    let index = values.len() - 1;
    unsafe { *values.get_unchecked(index) } //~ pos
}

pub fn read_last_checked(values: &[u8]) -> Option<u8> {
    values.last().copied() //~ neg
}

pub unsafe fn from_raw(pointer: *const u8, len: usize) -> Vec<u8> { //~ pos
    let slice = unsafe { std::slice::from_raw_parts(pointer, len) }; //~ pos
    slice.to_vec()
}

pub fn from_slice(values: &[u8]) -> Vec<u8> {
    values.to_vec() //~ neg
}

pub unsafe fn write_at(pointer: *mut u8, value: u8) { //~ pos
    unsafe { *pointer = value }; //~ pos
}

pub fn write_at_checked(buffer: &mut [u8], index: usize, value: u8) {
    if let Some(slot) = buffer.get_mut(index) { //~ neg
        *slot = value;
    }
}

pub fn transmute_len(value: u32) -> [u8; 4] {
    unsafe { std::mem::transmute::<u32, [u8; 4]>(value) } //~ pos
}

pub fn transmute_len_checked(value: u32) -> [u8; 4] {
    value.to_le_bytes() //~ neg
}

pub unsafe fn free_handle(handle: *mut c_void) { //~ pos
    let _ = handle;
}

pub fn close_handle(handle: Option<Box<u8>>) {
    drop(handle); //~ neg
}

pub fn as_str_unchecked(bytes: &[u8]) -> &str {
    unsafe { std::str::from_utf8_unchecked(bytes) } //~ pos
}

pub fn as_str_checked(bytes: &[u8]) -> Result<&str, std::str::Utf8Error> {
    std::str::from_utf8(bytes) //~ neg
}

pub struct RawBuffer {
    pointer: *mut u8,
    len: usize,
}

unsafe impl Send for RawBuffer {} //~ pos
unsafe impl Sync for RawBuffer {} //~ pos

impl RawBuffer {
    pub fn len(&self) -> usize {
        self.len //~ neg
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0 //~ neg
    }

    pub fn as_slice(&self) -> &[u8] {
        unsafe { std::slice::from_raw_parts(self.pointer, self.len) } //~ pos
    }

    pub fn to_vec_checked(&self) -> Vec<u8> {
        Vec::new() //~ neg
    }
}

pub fn offset_read(values: &[u8], offset: isize) -> u8 {
    unsafe { *values.as_ptr().offset(offset) } //~ pos
}

pub fn offset_read_checked(values: &[u8], offset: usize) -> Option<u8> {
    values.get(offset).copied() //~ neg
}

pub fn zeroed_page() -> [u8; 16] {
    unsafe { std::mem::zeroed() } //~ pos
}

pub fn zeroed_page_checked() -> [u8; 16] {
    [0_u8; 16] //~ neg
}

pub fn swap_raw(left: &mut u8, right: &mut u8) {
    unsafe { std::ptr::swap(left, right) }; //~ pos
}

pub fn swap_checked(left: &mut u8, right: &mut u8) {
    std::mem::swap(left, right); //~ neg
}
