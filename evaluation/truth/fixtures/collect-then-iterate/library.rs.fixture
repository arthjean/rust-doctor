//! rust-doctor truth fixture
//! rule: collect-then-iterate
//! crate-role: library
//! source-surface: library
//! target-path: src/lib.rs
//! edition: 2024
//! msrv: 1.97

pub fn sum_lengths(values: &[String]) -> usize {
    values.iter().map(String::len).collect::<Vec<_>>().iter().sum() //~ pos
}

pub fn sum_lengths_direct(values: &[String]) -> usize {
    values.iter().map(String::len).sum() //~ neg
}

pub fn count_matches(values: &[String], needle: &str) -> usize {
    values.iter().filter(|value| value.contains(needle)).collect::<Vec<_>>().iter().count() //~ pos
}

pub fn count_matches_direct(values: &[String], needle: &str) -> usize {
    values.iter().filter(|value| value.contains(needle)).count() //~ neg
}

pub fn uppercase_all(values: &[String]) -> Vec<String> {
    values.iter().map(|value| value.to_uppercase()).collect::<Vec<_>>().into_iter().collect() //~ pos
}

pub fn uppercase_all_direct(values: &[String]) -> Vec<String> {
    values.iter().map(|value| value.to_uppercase()).collect() //~ neg
}

pub fn first_long(values: &[String]) -> Option<String> {
    values.iter().cloned().collect::<Vec<_>>().into_iter().find(|value| value.len() > 8) //~ pos
}

pub fn first_long_direct(values: &[String]) -> Option<String> {
    values.iter().find(|value| value.len() > 8).cloned() //~ neg
}

pub fn joined(values: &[String]) -> String {
    values.iter().collect::<Vec<_>>().iter().map(|value| value.as_str()).collect() //~ pos
}

pub fn joined_direct(values: &[String]) -> String {
    values.iter().map(String::as_str).collect() //~ neg
}

pub fn materialized(values: &[String]) -> Vec<String> {
    let collected: Vec<String> = values.to_vec(); //~ neg
    collected.iter().cloned().collect() //~ neg
}

pub fn sorted(values: &[String]) -> Vec<String> {
    let mut collected: Vec<String> = values.iter().cloned().collect(); //~ neg
    collected.sort();
    collected
}

pub fn max_length(values: &[String]) -> usize {
    values.iter().map(String::len).collect::<Vec<_>>().iter().copied().max().unwrap_or(0) //~ pos
}

pub fn max_length_direct(values: &[String]) -> usize {
    values.iter().map(String::len).max().unwrap_or(0) //~ neg
}

pub fn distinct(values: &[String]) -> usize {
    values.iter().collect::<std::collections::BTreeSet<_>>().iter().count() //~ pos
}

pub fn distinct_direct(values: &[String]) -> usize {
    values.iter().collect::<std::collections::BTreeSet<_>>().len() //~ neg
}

pub fn zipped(left: &[String], right: &[String]) -> usize {
    left.iter().zip(right.iter()).collect::<Vec<_>>().iter().count() //~ pos
}

pub fn zipped_direct(left: &[String], right: &[String]) -> usize {
    left.iter().zip(right.iter()).count() //~ neg
}

pub fn enumerated(values: &[String]) -> usize {
    values.iter().enumerate().collect::<Vec<_>>().into_iter().count() //~ pos
}

pub fn enumerated_direct(values: &[String]) -> usize {
    values.iter().enumerate().count() //~ neg
}

pub fn flattened(rows: &[Vec<String>]) -> usize {
    rows.iter().flatten().collect::<Vec<_>>().iter().count() //~ pos
}

pub fn flattened_direct(rows: &[Vec<String>]) -> usize {
    rows.iter().flatten().count() //~ neg
}

pub fn reversed(values: &[String]) -> Vec<String> {
    values.iter().cloned().collect::<Vec<_>>().into_iter().rev().collect() //~ pos
}

pub fn reversed_direct(values: &[String]) -> Vec<String> {
    values.iter().rev().cloned().collect() //~ neg
}

pub fn skipped(values: &[String]) -> usize {
    values.iter().skip(1).collect::<Vec<_>>().iter().count() //~ pos
}

pub fn skipped_direct(values: &[String]) -> usize {
    values.iter().skip(1).count() //~ neg
}

pub fn taken(values: &[String]) -> usize {
    values.iter().take(3).collect::<Vec<_>>().into_iter().count() //~ pos
}

pub fn taken_direct(values: &[String]) -> usize {
    values.iter().take(3).count() //~ neg
}
