pub fn classify_status_1(code: u32) -> &'static str { //~ pos
    match code {
        0 => "state0", 1 => "state1", 2 => "state2", 3 => "state3", 4 => "state4", 5 => "state5",
        6 => "state6", 7 => "state7", 8 => "state8", 9 => "state9", 10 => "state10", 11 => "state11",
        12 => "state12", 13 => "state13", 14 => "state14", 15 => "state15", 16 => "state16", 17 => "state17",
        _ => "unknown",
    }
}

