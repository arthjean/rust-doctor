//! rust-doctor truth fixture
//! rule: unsafe-block-audit
//! crate-role: binary
//! source-surface: binary
//! target-path: src/main.rs
//! edition: 2024
//! msrv: 1.97

fn main() {
    let values = [1_u8, 2, 3];
    println!("{}", peek(&values));
}

fn peek(values: &[u8]) -> u8 {
    unsafe { *values.get_unchecked(0) } //~ pos
}

fn peek_checked(values: &[u8]) -> u8 {
    values.first().copied().unwrap_or_default() //~ neg
}

unsafe fn raw_len(pointer: *const u8) -> usize { //~ pos
    let _ = pointer;
    0
}

fn safe_len(values: &[u8]) -> usize {
    values.len() //~ neg
}

fn copy_raw(source: &[u8], target: &mut [u8]) {
    unsafe { std::ptr::copy_nonoverlapping(source.as_ptr(), target.as_mut_ptr(), source.len()) }; //~ pos
}

fn copy_checked(source: &[u8], target: &mut [u8]) {
    target[..source.len()].copy_from_slice(source); //~ neg
}

unsafe fn env_override(name: &str, value: &str) { //~ pos
    let _ = (name, value);
}

fn env_read(name: &str) -> String {
    std::env::var(name).unwrap_or_default() //~ neg
}

fn reinterpret(value: u64) -> [u8; 8] {
    unsafe { std::mem::transmute::<u64, [u8; 8]>(value) } //~ pos
}

fn reinterpret_checked(value: u64) -> [u8; 8] {
    value.to_be_bytes() //~ neg
}

fn assume_utf8(bytes: &[u8]) -> String {
    unsafe { String::from_utf8_unchecked(bytes.to_vec()) } //~ pos
}

fn assume_utf8_checked(bytes: &[u8]) -> String {
    String::from_utf8_lossy(bytes).into_owned() //~ neg
}

fn uninit_page() -> [u8; 32] {
    unsafe { std::mem::zeroed() } //~ pos
}

fn uninit_page_checked() -> [u8; 32] {
    [0_u8; 32] //~ neg
}
