pub fn checked_add(left: u32, right: u32) -> Option<u32> {
    left.checked_add(right) //~ neg
}

pub fn checked_sub(left: u32, right: u32) -> Option<u32> {
    left.checked_sub(right) //~ neg
}

pub fn first(values: &[u8]) -> Option<u8> {
    values.first().copied() //~ neg
}

pub fn to_string_lossy(bytes: &[u8]) -> String {
