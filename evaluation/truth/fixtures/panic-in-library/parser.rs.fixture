#[derive(Debug)]
pub struct ParseError(pub String);

pub fn parse_header(raw: &str) -> (String, String) {
    let Some((name, value)) = raw.split_once(':') else {
        panic!("header without a separator: {raw}"); //~ pos
    };
    (name.trim().to_string(), value.trim().to_string())
}

pub fn parse_header_checked(raw: &str) -> Result<(String, String), ParseError> {
    raw.split_once(':') //~ neg
        .map(|(name, value)| (name.trim().to_string(), value.trim().to_string()))
        .ok_or_else(|| ParseError(raw.to_string()))
}

pub fn parse_number(raw: &str) -> i64 {
    raw.parse().unwrap_or_else(|_| panic!("not a number: {raw}")) //~ pos
}

pub fn parse_number_checked(raw: &str) -> Result<i64, ParseError> {
    raw.parse().map_err(|_| ParseError(raw.to_string())) //~ neg
}

pub fn parse_bool(raw: &str) -> bool {
    match raw {
        "true" | "1" => true,
        "false" | "0" => false,
        other => panic!("not a boolean: {other}"), //~ pos
    }
}

pub fn parse_bool_checked(raw: &str) -> Option<bool> {
    match raw { //~ neg
        "true" | "1" => Some(true),
        "false" | "0" => Some(false),
        _ => None,
    }
}

pub fn expect_version(version: u8) {
    if version != 1 {
        panic!("unsupported wire version {version}"); //~ pos
    }
}

pub fn expect_version_checked(version: u8) -> Result<(), ParseError> {
    if version == 1 { Ok(()) } else { Err(ParseError(version.to_string())) } //~ neg
}

pub fn parse_list(raw: &str) -> Vec<String> {
    if raw.is_empty() {
        todo!("empty lists are not specified"); //~ pos
    }
    raw.split(',').map(str::to_string).collect()
}

pub fn parse_list_checked(raw: &str) -> Vec<String> {
    if raw.is_empty() { //~ neg
        return Vec::new();
    }
    raw.split(',').map(str::to_string).collect()
}

pub fn parse_escape(byte: u8) -> char {
    match byte {
        b'n' => '\n',
        b't' => '\t',
        b'r' => '\r',
        _ => unimplemented!("escape sequence not supported"), //~ pos
    }
}

pub fn parse_escape_checked(byte: u8) -> Option<char> {
    match byte { //~ neg
        b'n' => Some('\n'),
        b't' => Some('\t'),
        b'r' => Some('\r'),
        _ => None,
    }
}

pub fn strict_len(raw: &str, expected: usize) -> usize {
    if raw.len() != expected {
        panic!("expected {expected} bytes, found {}", raw.len()); //~ pos
    }
    raw.len()
}

pub fn strict_len_checked(raw: &str, expected: usize) -> Result<usize, ParseError> {
    if raw.len() == expected { Ok(raw.len()) } else { Err(ParseError(raw.to_string())) } //~ neg
}

pub fn require_ascii(raw: &str) {
    if !raw.is_ascii() {
        panic!("non-ascii input rejected"); //~ pos
    }
}

pub fn require_ascii_checked(raw: &str) -> Result<(), ParseError> {
    if raw.is_ascii() { Ok(()) } else { Err(ParseError(raw.to_string())) } //~ neg
}

pub fn finish(remaining: usize) {
    if remaining != 0 {
        todo!("trailing bytes are unhandled"); //~ pos
    }
}

pub fn finish_checked(remaining: usize) -> Result<(), ParseError> {
    if remaining == 0 { Ok(()) } else { Err(ParseError(remaining.to_string())) } //~ neg
}

pub fn reject_empty(raw: &str) -> &str {
    if raw.is_empty() {
        panic!("empty payload is not decodable"); //~ pos
    }
    raw
}

pub fn reject_empty_checked(raw: &str) -> Result<&str, ParseError> {
    if raw.is_empty() { Err(ParseError(String::new())) } else { Ok(raw) } //~ neg
}

pub fn seal(state: u8) -> u8 {
    if state > 3 {
        unimplemented!("state {state} has no sealing rule"); //~ pos
    }
    state
}

pub fn seal_checked(state: u8) -> Option<u8> {
    (state <= 3).then_some(state) //~ neg
}
