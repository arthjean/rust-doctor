//! rust-doctor truth fixture
//! rule: unnecessary-allocation
//! crate-role: binary
//! source-surface: binary
//! target-path: src/main.rs
//! edition: 2024
//! msrv: 1.97

fn main() {
    let rows = vec![vec![1_u8, 2], vec![3]];
    println!("{}", encode_all(&rows).len());
}

fn encode_all(rows: &[Vec<u8>]) -> Vec<String> {
    let mut encoded = Vec::new(); //~ neg
    for row in rows {
        let mut line = String::new(); //~ pos
        for byte in row {
            let chunk = String::new(); //~ pos
            line.push_str(&chunk);
            line.push_str(&byte.to_string());
        }
        encoded.push(line);
    }
    encoded
}

fn encode_all_hoisted(rows: &[Vec<u8>]) -> Vec<String> {
    let mut encoded = Vec::with_capacity(rows.len()); //~ neg
    let mut line = String::new(); //~ neg
    for row in rows {
        line.clear();
        for byte in row {
            line.push_str(&byte.to_string());
        }
        encoded.push(line.clone());
    }
    encoded
}

fn scan_pages(pages: usize) -> Vec<Vec<u8>> {
    let mut output = Vec::new(); //~ neg
    let mut page = 0;
    while page < pages {
        let buffer = Vec::new(); //~ pos
        output.push(buffer);
        page += 1;
    }
    output
}

fn scan_pages_capacity(pages: usize) -> Vec<Vec<u8>> {
    let mut output = Vec::with_capacity(pages); //~ neg
    let mut page = 0;
    while page < pages {
        output.push(Vec::with_capacity(4096)); //~ neg
        page += 1;
    }
    output
}

fn retry_loop(limit: usize) -> String {
    let mut attempts = 0;
    loop {
        let scratch = String::new(); //~ pos
        attempts += scratch.len() + 1;
        if attempts >= limit {
            return attempts.to_string();
        }
    }
}

fn retry_loop_hoisted(limit: usize) -> String {
    let scratch = String::new(); //~ neg
    let mut attempts = 0;
    loop {
        attempts += scratch.len() + 1;
        if attempts >= limit {
            return attempts.to_string();
        }
    }
}

fn shard(rows: &[Vec<u8>], shards: usize) -> Vec<Vec<u8>> {
    let mut output = Vec::new(); //~ neg
    for _ in 0..shards {
        let bucket = Vec::new(); //~ pos
        output.push(bucket);
    }
    for (index, row) in rows.iter().enumerate() {
        output[index % shards].extend_from_slice(row);
    }
    output
}

fn shard_preallocated(rows: &[Vec<u8>], shards: usize) -> Vec<Vec<u8>> {
    let mut output = vec![Vec::new(); shards]; //~ neg
    for (index, row) in rows.iter().enumerate() {
        output[index % shards].extend_from_slice(row); //~ neg
    }
    output
}

fn split_records(raw: &str) -> Vec<Vec<String>> {
    let mut records = Vec::new(); //~ neg
    for line in raw.lines() {
        let mut fields = Vec::new(); //~ pos
        for field in line.split(',') {
            let mut owned = String::new(); //~ pos
            owned.push_str(field);
            fields.push(owned);
        }
        records.push(fields);
    }
    records
}

fn split_records_direct(raw: &str) -> Vec<Vec<String>> {
    raw.lines() //~ neg
        .map(|line| line.split(',').map(str::to_string).collect())
        .collect()
}

fn warm_cache(entries: usize) -> Vec<Vec<u8>> {
    let mut cache = Vec::new(); //~ neg
    let mut index = 0;
    while index < entries {
        let block = Vec::new(); //~ pos
        cache.push(block);
        index += 1;
    }
    cache
}
