pub struct Pool;
pub struct Statement;

impl Pool {
    pub fn query(&self, _sql: &str) -> Vec<String> { Vec::new() }
    pub fn query_as(&self, _sql: &str) -> Vec<String> { Vec::new() }
    pub fn execute(&self, _sql: &str) -> usize { 0 }
    pub fn execute_raw(&self, _sql: &str) -> usize { 0 }
    pub fn raw(&self, _sql: &str) -> Vec<String> { Vec::new() }
    pub fn prepare(&self, _sql: &str) -> Statement { Statement }
    pub fn fetch_one(&self, _sql: &str) -> String { String::new() }
}

impl Statement {
    pub fn bind(&self, _value: &str) -> &Self { self }
    pub fn run(&self) -> usize { 0 }
}

pub fn find_user(pool: &Pool, name: &str) -> Vec<String> {
    pool.query(&format!("SELECT * FROM users WHERE name = '{name}'")) //~ pos
}

pub fn find_user_bound(pool: &Pool, name: &str) -> usize {
    pool.prepare("SELECT * FROM users WHERE name = $1").bind(name).run() //~ neg
}

pub fn delete_user(pool: &Pool, id: u64) -> usize {
    pool.execute(&format!("DELETE FROM users WHERE id = {id}")) //~ pos
}

pub fn delete_user_bound(pool: &Pool, id: u64) -> usize {
    let _ = id;
    pool.prepare("DELETE FROM users WHERE id = $1").run() //~ neg
}

pub fn count_orders(pool: &Pool, status: &str) -> Vec<String> {
    pool.query_as(&format!("SELECT count(*) FROM orders WHERE status = '{status}'")) //~ pos
}

pub fn count_orders_bound(pool: &Pool, status: &str) -> Vec<String> {
    let _ = status;
    pool.query_as("SELECT count(*) FROM orders WHERE status = $1") //~ neg
}

pub fn purge(pool: &Pool, table: &str) -> Vec<String> {
    pool.raw(&format!("TRUNCATE TABLE {table}")) //~ pos
}

pub fn purge_allowlisted(pool: &Pool, table: &str) -> Vec<String> {
    match table { //~ neg
        "orders" => pool.raw("TRUNCATE TABLE orders"),
        _ => Vec::new(),
    }
}

pub fn rotate(pool: &Pool, shard: u8) -> usize {
    pool.execute_raw(&format!("ALTER TABLE shard_{shard} SET LOGGED")) //~ pos
}

pub fn rotate_static(pool: &Pool) -> usize {
    pool.execute_raw("ALTER TABLE shard_0 SET LOGGED") //~ neg
}

pub fn search(pool: &Pool, needle: &str) -> Vec<String> {
    pool.query(format!("SELECT * FROM docs WHERE body LIKE '%{needle}%'").as_str()) //~ pos
}

pub fn search_direct(pool: &Pool, needle: &str) -> Vec<String> {
    pool.query(&format!("SELECT * FROM docs WHERE body LIKE '%{needle}%'")) //~ pos
}

