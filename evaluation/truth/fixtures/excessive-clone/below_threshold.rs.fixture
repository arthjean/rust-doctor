//! rust-doctor truth fixture
//! rule: excessive-clone
//! crate-role: library
//! source-surface: library
//! target-path: src/config.rs
//! edition: 2024
//! msrv: 1.97

#[derive(Clone, Debug, Default)]
pub struct Settings {
    pub name: String,
}

pub fn with_name(settings: &Settings, name: &str) -> Settings {
    let mut updated = settings.clone(); //~ neg
    updated.name = name.to_owned(); //~ neg
    updated
}

pub fn duplicate(settings: &Settings) -> Settings {
    settings.clone() //~ neg
}

pub fn name_of(settings: &Settings) -> &str {
    settings.name.as_str() //~ neg
}

pub fn is_named(settings: &Settings) -> bool {
    !settings.name.is_empty() //~ neg
}
