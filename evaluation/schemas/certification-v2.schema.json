{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-doctor.dev/schemas/certification-v2.schema.json",
  "title": "Rust Doctor decision-quality certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certified",
    "generated_at_utc_unix_seconds",
    "command"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "certified": { "type": "boolean" },
    "generated_at_utc_unix_seconds": { "type": "integer", "minimum": 1 },
    "command": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|/home/|/Users/)" }
      }
    },
    "tool_version": { "type": "string", "minLength": 1 },
    "release_binary_sha256": { "$ref": "#/$defs/sha256" },
    "score_model_version": { "type": "string", "minLength": 1 },
    "rust_toolchain": { "type": "string", "minLength": 1 },
    "operating_system": { "type": "string", "minLength": 1 },
    "architecture": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "calibration_version": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "roots_total",
        "roots_complete",
        "roots_incomplete",
        "roots_failed",
        "roots_not_attempted",
        "tool_revision"
      ],
      "properties": {
        "repositories": { "type": "integer", "minimum": 0 },
        "roots_total": { "type": "integer", "minimum": 0 },
        "roots_complete": { "type": "integer", "minimum": 0 },
        "roots_incomplete": { "type": "integer", "minimum": 0 },
        "roots_failed": { "type": "integer", "minimum": 0 },
        "roots_not_attempted": { "type": "integer", "minimum": 0 },
        "tool_revision": { "type": "string", "minLength": 1 }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "supported_versions",
          "conformance_sha256",
          "passed"
        ],
        "properties": {
          "adapter": { "type": "string", "minLength": 1 },
          "supported_versions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "conformance_sha256": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "self_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "score",
        "label",
        "authoritative",
        "reason_codes",
        "scored_groups",
        "advisory_groups",
        "audit_groups",
        "top_remediations"
      ],
      "properties": {
        "case": { "const": "rust-doctor-self-scan" },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "label": { "type": ["string", "null"] },
        "authoritative": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scored_groups": { "type": "integer", "minimum": 0 },
        "advisory_groups": { "type": "integer", "minimum": 0 },
        "audit_groups": { "type": "integer", "minimum": 0 },
        "top_remediations": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "object" }
        }
      }
    },
    "release_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "release_binary_sha256",
        "tool_revision",
        "generated_at_utc_unix_seconds",
        "gates"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "release_binary_sha256": { "$ref": "#/$defs/sha256" },
        "tool_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "generated_at_utc_unix_seconds": { "type": "integer", "minimum": 1 },
        "gates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/release_gate" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "blocking_rules": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "certified": { "const": true } },
        "required": ["certified"]
      },
      "then": {
        "required": [
          "tool_version",
          "release_binary_sha256",
          "score_model_version",
          "rust_toolchain",
          "operating_system",
          "architecture",
          "dataset_version",
          "calibration_version",
          "artifacts",
          "corpus",
          "adapters",
          "self_scan",
          "release_evidence",
          "gates",
          "blocking_rules"
        ],
        "not": { "required": ["error"] },
        "properties": {
          "artifacts": { "minProperties": 10 },
          "corpus": {
            "properties": {
              "repositories": { "minimum": 100 },
              "roots_total": { "minimum": 260 },
              "roots_complete": { "minimum": 260 },
              "tool_revision": { "pattern": "^[0-9a-fA-F]{40}$" }
            }
          },
          "adapters": {
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "properties": {
                "conformance_sha256": { "$ref": "#/$defs/sha256" },
                "passed": { "const": true }
              }
            }
          },
          "self_scan": {
            "properties": {
              "score": { "type": "integer" },
              "label": { "enum": ["Great", "Needs work", "Critical"] },
              "authoritative": { "const": true }
            }
          },
          "release_evidence": {
            "properties": {
              "gates": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/release_gate" },
                    { "properties": { "passed": { "const": true } } }
                  ]
                }
              }
            }
          },
          "gates": {
            "minItems": 18,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/gate" },
                { "properties": { "passed": { "const": true } } }
              ]
            }
          },
          "blocking_rules": { "maxProperties": 0 }
        }
      },
      "else": { "required": ["error"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|/home/|/Users/)" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "passed", "command", "detail", "artifact"],
      "properties": {
        "gate": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "passed", "detail"],
      "properties": {
        "gate": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
